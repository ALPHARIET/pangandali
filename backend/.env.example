# Salin ke backend/.env lalu isi. JANGAN commit file .env.
APP_ENV=dev
# Dev lokal boleh SQLite; production pakai PostgreSQL:
# DATABASE_URL=postgresql+psycopg://pangandali:pangandali@localhost:5432/pangandali
DATABASE_URL=sqlite:///./pangandali.db
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
ADMIN_EMAIL=admin@pangandali.id
ADMIN_PASSWORD=
ADMIN_NAME=Admin Dinas Pertanian
# Password bersama akun demo (driver/distributor/tpid *.demo@pangandali.id). Kosong = acak saat seed.
# Setelah diubah: python -m app.seed --set-demo-password
DEMO_PASSWORD=

# Opsional: kunci Fernet bila nanti ada secret yang disimpan di DB (saat ini tidak ada).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# LLM OpenAI-compatible. Base URL sampai sebelum /chat/completions.
# Cek koneksi & dukungan tool calling: python -m app.cek_llm
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
AGENT_MAX_ITERATIONS=6
AGENT_HISTORY_MESSAGES=12

# Aturan operasional. Nilai di bawah hanya titik awal uji, BUKAN hasil kesepakatan mitra.
# Ubah sesuai kesepakatan pengelola lalu jalankan ulang API.
BATAS_JEMPUT_HARI=2               # jendela jemput: tanggal panen s.d. +N hari
MAKS_DEVIASI_KM=40                # tambahan jarak maksimum agar armada direkomendasikan
BATAS_RESPON_PETANI_JAM=12        # lama volume pesanan dikunci menunggu jawaban petani
BATAS_RESPON_DRIVER_MENIT=60      # lama penawaran ke satu armada sebelum diteruskan
PEMBANDING_PULANG_PERGI=true      # skenario pembanding BBM: perjalanan khusus pulang-pergi
AMBANG_STOK_RENDAH_KG=200         # peringatan stok rendah
AMBANG_KENAIKAN_HARGA_PERSEN=15   # peringatan kenaikan harga vs rata-rata 7 hari
AMBANG_VALIDASI_TERTUNDA_JAM=24   # peringatan laporan belum divalidasi
MAKS_KIRIM_ULANG=5                # batas kirim ulang pesan WA yang gagal

# WhatsApp Cloud API (Meta)
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v21.0
# Template yang disetujui Meta, dengan satu variabel body {{1}}, untuk notifikasi di luar jendela 24 jam
WA_NOTIFY_TEMPLATE=
WA_TEMPLATE_LANG=id

# wa-bridge (Baileys, scan QR) - TIDAK RESMI, hanya uji lokal/demo dengan nomor cadangan.
# Isi WA_WEB_SECRET dengan string acak panjang; bridge membaca nilai yang sama dari file ini.
WA_WEB_BRIDGE_URL=http://127.0.0.1:3010
WA_WEB_SECRET=
